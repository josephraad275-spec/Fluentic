# Server only. Never prefix this key with VITE_ or commit a real credential.
GEMINI_API_KEY=
# Defaults are documented Google models; configure according to account access.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
PORT=3000
NODE_ENV=production
